{
  "name": "noelia-perucci-demo",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./worker/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noelia-perucci-db",
      "database_id": "99544401-8ea6-42ea-8b82-d3618a73f87a",
      "migrations_dir": "migrations"
    }
  ]
}
